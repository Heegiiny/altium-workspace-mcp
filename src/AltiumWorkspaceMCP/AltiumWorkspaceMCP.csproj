<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>altium-vault-mcp</AssemblyName>
    <Version>0.1.0</Version>
    <RootNamespace>AltiumWorkspaceMCP</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- stdio is taken by the MCP protocol: nothing extra may reach the console -->
    <NoLogo>true</NoLogo>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AltiumWorkspaceMCP.Tests" />
  </ItemGroup>

  <!-- Instructions the client passes to the model on connect -->
  <ItemGroup>
    <EmbeddedResource Include="Mcp\ServerInstructions.md" LogicalName="ServerInstructions.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.2" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.1.2" />
    <!-- A transitive dependency of WCF 8.1.2 pulls in the vulnerable 8.0.2 (GHSA-w3x6-4m5h-cxqf and others) -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    <!-- DPAPI to encrypt the persisted session identifier -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

</Project>
